# Preserve byte hashes of captured native Windows output, including CRLF.
# Treat CR as a line terminator while retaining normal whitespace checks.
*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
