# Planning template only: the app and these configuration readers are not implemented yet.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/card-coach.sqlite
AI_MODE=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_DEADLINE_MS=4000
JEV_MAX_RETRIES=1
JEV_MAX_CONCURRENCY=4
# Set an owner-approved ceiling during the capability spike. Zero blocks live usage.
JEV_DAILY_INPUT_TOKEN_LIMIT=0
GUEST_RETENTION_DAYS=30
# Never expose TYPESAFE_API_KEY through a VITE_ variable or client build.
# Explicit deterministic development mode: change AI_MODE to demo.
