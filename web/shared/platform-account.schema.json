{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trickscoach.com/schemas/platform-account-v1.json",
  "title": "M04E account and preferences contracts",
  "$defs": {
    "PlatformPreferencesView": {
      "title": "PlatformPreferencesView",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        }
      },
      "required": [
        "schemaVersion",
        "revision",
        "preferences"
      ],
      "additionalProperties": false
    },
    "PlatformPreferencesRequest": {
      "title": "PlatformPreferencesRequest",
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedPreferencesRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        }
      },
      "required": [
        "commandId",
        "expectedPreferencesRevision",
        "preferences"
      ],
      "additionalProperties": false
    },
    "PlatformAccountAvailability": {
      "title": "PlatformAccountAvailability",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/RegisteredTarget"
        },
        "play": {
          "$ref": "#/$defs/AccessDecision"
        },
        "coach": {
          "$ref": "#/$defs/AccessDecision"
        },
        "trialEligibleOfferIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "target",
        "play",
        "coach",
        "trialEligibleOfferIds"
      ],
      "additionalProperties": false
    },
    "PlatformAccountView": {
      "title": "PlatformAccountView",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "mode": {
              "const": "fixture"
            },
            "accessGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "player": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "id",
                "displayName"
              ],
              "additionalProperties": false
            },
            "preferences": {
              "$ref": "#/$defs/PlatformPreferencesView"
            },
            "fixtureAccount": {
              "$ref": "#/$defs/PlatformFixtureAccountView"
            },
            "offers": {
              "type": "null"
            },
            "availability": {
              "type": "array",
              "minItems": 3,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/PlatformAccountAvailability"
              }
            },
            "billingAvailable": {
              "const": true
            },
            "familyAvailable": {
              "const": true
            }
          },
          "required": [
            "schemaVersion",
            "mode",
            "accessGeneration",
            "player",
            "preferences",
            "fixtureAccount",
            "offers",
            "availability",
            "billingAvailable",
            "familyAvailable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "mode": {
              "const": "configured"
            },
            "accessGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "player": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "id",
                "displayName"
              ],
              "additionalProperties": false
            },
            "preferences": {
              "$ref": "#/$defs/PlatformPreferencesView"
            },
            "fixtureAccount": {
              "type": "null"
            },
            "offers": {
              "$ref": "#/$defs/AccessOfferPolicy"
            },
            "availability": {
              "type": "array",
              "minItems": 3,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/PlatformAccountAvailability"
              }
            },
            "billingAvailable": {
              "const": false
            },
            "familyAvailable": {
              "const": false
            }
          },
          "required": [
            "schemaVersion",
            "mode",
            "accessGeneration",
            "player",
            "preferences",
            "fixtureAccount",
            "offers",
            "availability",
            "billingAvailable",
            "familyAvailable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PlatformExportDecision": {
      "title": "PlatformExportDecision",
      "type": "object",
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy": {
          "$ref": "#/$defs/VersionedComponent"
        },
        "packetVersion": {
          "const": "2.0.0"
        },
        "analysis": {
          "$ref": "#/$defs/RegisteredAnalysis"
        },
        "advice": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/AdviceView"
          }
        }
      },
      "required": [
        "decisionId",
        "gameId",
        "revision",
        "policy",
        "packetVersion",
        "analysis",
        "advice"
      ],
      "additionalProperties": false
    },
    "PlatformExportView": {
      "title": "PlatformExportView",
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": "platform-export-1"
        },
        "exportedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mode": {
          "const": "local-test"
        },
        "account": {
          "$ref": "#/$defs/PlatformAccountView"
        },
        "games": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "view": {
                "$ref": "#/$defs/RegisteredSessionView"
              }
            },
            "required": [
              "id",
              "revision",
              "view"
            ],
            "additionalProperties": false
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/PlatformExportDecision"
          }
        },
        "coachedUnits": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "properties": {
              "gameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "unitId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "unlockedAt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "offer": {
                "$ref": "#/$defs/VersionedComponent"
              }
            },
            "required": [
              "gameId",
              "unitId",
              "unlockedAt",
              "offer"
            ],
            "additionalProperties": false
          }
        },
        "billing": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/BillingOperation"
          }
        },
        "coachSessions": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "./platform-coach.schema.json#/$defs/CoachUISession" }
        },
        "coachFeedback": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "./platform-coach.schema.json#/$defs/CoachUIFeedbackView" }
        }
      },
      "required": [
        "formatVersion",
        "exportedAt",
        "mode",
        "account",
        "games",
        "decisions",
        "coachedUnits",
        "billing"
      ],
      "additionalProperties": false
    },
    "PlatformFixtureAccountView": {
      "title": "PlatformFixtureAccountView",
      "type": "object",
      "properties": {
        "authMode": {
          "const": "local-test"
        },
        "player": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "id",
            "displayName"
          ],
          "additionalProperties": false
        },
        "access": {
          "$ref": "#/$defs/CoachAccess"
        },
        "subscription": {
          "$ref": "#/$defs/SubscriptionView"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OfferView"
          },
          "maxItems": 3
        }
      },
      "required": [
        "authMode",
        "player",
        "access",
        "subscription",
        "offers"
      ],
      "additionalProperties": false
    },
    "PlatformFamilyCommand": {
      "title": "PlatformFamilyCommand",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action": {
              "const": "create"
            }
          },
          "required": [
            "commandId",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action": {
              "const": "invite"
            },
            "inviteeId": {
              "type": "string",
              "minLength": 48,
              "maxLength": 48,
              "pattern": "^[a-f0-9]{48}$"
            },
            "seatClass": {
              "enum": [
                "unlimited",
                "limited"
              ]
            }
          },
          "required": [
            "commandId",
            "action",
            "inviteeId",
            "seatClass"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action": {
              "const": "accept"
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "acknowledgeIndividualCoverage": {
              "type": "boolean"
            }
          },
          "required": [
            "commandId",
            "action",
            "token",
            "acknowledgeIndividualCoverage"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action": {
              "const": "revoke-invite"
            },
            "invitationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "commandId",
            "action",
            "invitationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action": {
              "const": "remove"
            },
            "assignmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "commandId",
            "action",
            "assignmentId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "commandId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "action": {
              "const": "leave"
            }
          },
          "required": [
            "commandId",
            "action"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
