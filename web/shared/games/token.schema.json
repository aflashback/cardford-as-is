{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trickscoach.com/schemas/games/token.schema.json",
  "$defs": {
    "TokenReveal": {
      "title": "TokenReveal",
      "type": "object",
      "properties": {
        "seat": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
        },
        "token": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "seat",
        "token"
      ],
      "additionalProperties": false
    },
    "TokenCycle": {
      "title": "TokenCycle",
      "type": "object",
      "properties": {
        "reveals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenReveal"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "collector": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
        }
      },
      "required": [
        "reveals",
        "collector"
      ],
      "additionalProperties": false
    },
    "TokenCompetitor": {
      "title": "TokenCompetitor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
          },
          "maxItems": 2,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "seats"
      ],
      "additionalProperties": false
    },
    "TokenObservation": {
      "title": "TokenObservation",
      "type": "object",
      "properties": {
        "gameId": {
          "const": "test-token"
        },
        "variant": {
          "enum": [
            "individual",
            "neighbour-teams"
          ]
        },
        "seat": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
        },
        "phase": {
          "enum": [
            "chance",
            "reveal",
            "collect",
            "complete"
          ]
        },
        "own": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "held": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "maxItems": 4,
          "minItems": 4
        },
        "current": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenReveal"
          },
          "maxItems": 4
        },
        "cycles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenCycle"
          },
          "maxItems": 5
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "maxItems": 4,
          "minItems": 4
        },
        "competition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenCompetitor"
          },
          "maxItems": 4,
          "minItems": 2
        },
        "turn": {
          "anyOf": [
            {
              "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "winners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 4
        }
      },
      "required": [
        "gameId",
        "variant",
        "seat",
        "phase",
        "own",
        "held",
        "current",
        "cycles",
        "collections",
        "competition",
        "turn",
        "winners"
      ],
      "additionalProperties": false
    },
    "TokenCandidate": {
      "title": "TokenCandidate",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "public": {
          "title": "TokenRevealAction",
          "type": "object",
          "properties": {
            "kind": {
              "const": "reveal"
            },
            "token": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "kind",
            "token"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "public"
      ],
      "additionalProperties": false
    },
    "TokenActorPacket": {
      "title": "TokenActorPacket",
      "type": "object",
      "properties": {
        "publicSchemaVersion": {
          "const": "2.0.0"
        },
        "gameId": {
          "const": "test-token"
        },
        "variantId": {
          "enum": [
            "individual",
            "neighbour-teams"
          ]
        },
        "seat": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
        },
        "phase": {
          "enum": [
            "token-layout",
            "reveal",
            "collect",
            "complete"
          ]
        },
        "observation": {
          "$ref": "#/$defs/TokenObservation"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenCandidate"
          },
          "maxItems": 5
        }
      },
      "required": [
        "publicSchemaVersion",
        "gameId",
        "variantId",
        "seat",
        "phase",
        "observation",
        "candidates"
      ],
      "additionalProperties": false
    },
    "TokenSessionView": {
      "title": "TokenSessionView",
      "type": "object",
      "properties": {
        "publicSchemaVersion": {
          "const": "2.0.0"
        },
        "gameId": {
          "const": "test-token"
        },
        "variantId": {
          "enum": [
            "individual",
            "neighbour-teams"
          ]
        },
        "seat": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
        },
        "phase": {
          "enum": [
            "token-layout",
            "reveal",
            "collect",
            "complete"
          ]
        },
        "table": {
          "$ref": "#/$defs/TokenObservation"
        },
        "accessUnit": {
          "anyOf": [
            {
              "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/CoachedUnit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "publicSchemaVersion",
        "gameId",
        "variantId",
        "seat",
        "phase",
        "table",
        "accessUnit"
      ],
      "additionalProperties": false
    },
    "TokenAnalysis": {
      "title": "TokenAnalysis",
      "type": "object",
      "properties": {
        "publicSchemaVersion": {
          "const": "2.0.0"
        },
        "gameId": {
          "const": "test-token"
        },
        "variantId": {
          "enum": [
            "individual",
            "neighbour-teams"
          ]
        },
        "origin": {
          "enum": [
            "demo",
            "forced"
          ]
        },
        "selectedCandidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "objective": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/ReasoningObjective"
        },
        "horizon": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/ReasoningHorizon"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/ReasoningFact"
          }
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/ReasoningEstimate"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/ReasoningScenario"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        }
      },
      "required": [
        "publicSchemaVersion",
        "gameId",
        "variantId",
        "origin",
        "selectedCandidateId",
        "objective",
        "horizon",
        "facts",
        "estimates",
        "scenarios",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "TokenActorEvent": {
      "title": "TokenActorEvent",
      "type": "object",
      "properties": {
        "publicSchemaVersion": {
          "const": "2.0.0"
        },
        "gameId": {
          "const": "test-token"
        },
        "variantId": {
          "enum": [
            "individual",
            "neighbour-teams"
          ]
        },
        "eventSchemaVersion": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "enum": [
            "layout-requested",
            "tokens-assigned",
            "token-revealed",
            "cycle-collected"
          ]
        },
        "seat": {
          "anyOf": [
            {
              "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "publicSchemaVersion",
        "gameId",
        "variantId",
        "eventSchemaVersion",
        "id",
        "type",
        "seat",
        "token"
      ],
      "additionalProperties": false
    },
    "TokenPresentation": {
      "title": "TokenPresentation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gameId": {
          "const": "test-token"
        },
        "variantId": {
          "enum": [
            "individual",
            "neighbour-teams"
          ]
        },
        "seat": {
          "$ref": "https://trickscoach.com/schemas/local-v1.json#/$defs/Seat"
        },
        "observation": {
          "$ref": "#/$defs/TokenObservation"
        }
      },
      "required": [
        "id",
        "gameId",
        "variantId",
        "seat",
        "observation"
      ],
      "additionalProperties": false
    }
  }
}
