{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trickscoach.com/schemas/realtime-v1.json",
  "title": "Local realtime transport",
  "$defs": {
    "RealtimePlaybackRequest": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "controlLeaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedControlGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedPlaybackGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "boolean"
        },
        "intent": {
          "enum": [
            "resume",
            "pause",
            "hold",
            "release_hold"
          ]
        },
        "reason": {
          "enum": [
            "manual",
            "away",
            "layout_unavailable",
            "idle",
            "connection_lost",
            "service_unavailable",
            "lease_expired",
            "control_lost",
            "access_required",
            "reopened"
          ]
        }
      },
      "required": [
        "commandId",
        "gameId",
        "controlLeaseToken",
        "expectedControlGeneration",
        "expectedPlaybackGeneration",
        "running"
      ],
      "additionalProperties": false,
      "title": "RealtimePlaybackRequest"
    },
    "RealtimePlaybackView": {
      "type": "object",
      "properties": {
        "running": {
          "type": "boolean"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "running",
            "held",
            "paused",
            "expired",
            "completed"
          ]
        },
        "pauseReason": {
          "anyOf": [
            {
              "enum": [
                "manual",
                "away",
                "layout_unavailable",
                "idle",
                "connection_lost",
                "service_unavailable",
                "lease_expired",
                "control_lost",
                "access_required",
                "reopened"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "serverNow": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "foregroundLeaseUntil": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 20,
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pausedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 20,
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 20,
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policyVersion": {
          "enum": [
            "pause-v1",
            "legacy"
          ]
        },
        "retentionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "running",
        "generation"
      ],
      "additionalProperties": false,
      "title": "RealtimePlaybackView"
    },
    "RealtimeNegotiateView": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "local",
            "http"
          ]
        },
        "streamId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "mode",
        "streamId",
        "url"
      ],
      "additionalProperties": false,
      "title": "RealtimeNegotiateView"
    },
    "RealtimeSnapshotRequest": {
      "type": "object",
      "properties": {
        "streamId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "workIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "streamId",
        "workIds"
      ],
      "additionalProperties": false,
      "title": "RealtimeSnapshotRequest"
    },
    "RealtimeSnapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "streamId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "view": {
          "$ref": "./platform-service.schema.json#/$defs/PlatformSessionView"
        },
        "works": {
          "type": "array",
          "items": {
            "$ref": "./local-service.schema.json#/$defs/LocalServicePrepareView"
          },
          "maxItems": 4
        },
        "playback": {
          "$ref": "#/$defs/RealtimePlaybackView"
        }
      },
      "required": [
        "schemaVersion",
        "streamId",
        "sequence",
        "view",
        "works",
        "playback"
      ],
      "additionalProperties": false,
      "title": "RealtimeSnapshot"
    },
    "RealtimeMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "streamId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "session.view"
            },
            "view": {
              "$ref": "./platform-service.schema.json#/$defs/PlatformSessionView"
            },
            "playback": {
              "$ref": "#/$defs/RealtimePlaybackView"
            }
          },
          "required": [
            "schemaVersion",
            "messageId",
            "streamId",
            "sequence",
            "type",
            "view",
            "playback"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "streamId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "work.updated"
            },
            "work": {
              "$ref": "./local-service.schema.json#/$defs/LocalServicePrepareView"
            }
          },
          "required": [
            "schemaVersion",
            "messageId",
            "streamId",
            "sequence",
            "type",
            "work"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "streamId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "control.changed"
            },
            "controlGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "schemaVersion",
            "messageId",
            "streamId",
            "sequence",
            "type",
            "controlGeneration"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "streamId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "access.changed"
            },
            "accessGeneration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "schemaVersion",
            "messageId",
            "streamId",
            "sequence",
            "type",
            "accessGeneration"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "streamId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "work.updated"
            },
            "review": {
              "$ref": "./platform-review.schema.json#/$defs/PlatformReviewStatus"
            }
          },
          "required": [
            "schemaVersion",
            "messageId",
            "streamId",
            "sequence",
            "type",
            "review"
          ],
          "additionalProperties": false
        }
      ],
      "title": "RealtimeMessage"
    },
    "RealtimePresenceRequest": {
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "controlLeaseToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedControlGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedPlaybackGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gameId",
        "controlLeaseToken",
        "expectedControlGeneration",
        "expectedPlaybackGeneration",
        "sequence"
      ],
      "additionalProperties": false,
      "title": "RealtimePresenceRequest"
    }
  }
}
