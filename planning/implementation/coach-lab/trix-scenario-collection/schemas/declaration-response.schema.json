{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cardford.local/planning/trix-scenario/declaration-response-1.0.0.json",
  "title": "Proposed offline Trix declaration response",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards", "reasoning", "confidence"],
  "properties": {
    "cards": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\|[♠♥♦♣]\\|(A|K|Q|J|10|[2-9])\\|$"}},
    "reasoning": {"type": "string", "minLength": 1, "maxLength": 4000},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
