{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardford.local/schemas/trix-scenario-collection/case.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "trix-coaching-case-1.0.0"
    },
    "corpusId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "episodeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "familyId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "variant": {
      "enum": [
        "basic-solo",
        "complex-solo",
        "basic-partners",
        "complex-partners"
      ]
    },
    "request": {
      "enum": [
        "diamonds",
        "king",
        "queens",
        "lutoosh",
        "complex"
      ]
    },
    "pin": {
      "type": "object",
      "properties": {
        "gameId": {
          "const": "trix"
        },
        "variantId": {
          "enum": [
            "basic-solo",
            "complex-solo",
            "basic-partners",
            "complex-partners"
          ]
        },
        "moduleVersion": {
          "const": "2.2.0"
        },
        "ruleProfileId": {
          "enum": [
            "trix-basic-solo-1.0.0",
            "trix-complex-solo-1.0.0",
            "trix-basic-partners-1.1.0",
            "trix-complex-partners-1.1.0"
          ]
        },
        "stateSchemaVersion": {
          "const": "1.2.0"
        },
        "observationSchemaVersion": {
          "const": "1.2.0"
        },
        "publicSchemaVersion": {
          "const": "1.2.0"
        },
        "eventSchemaVersion": {
          "const": "1.0.0"
        }
      },
      "required": [
        "gameId",
        "variantId",
        "moduleVersion",
        "ruleProfileId",
        "stateSchemaVersion",
        "observationSchemaVersion",
        "publicSchemaVersion",
        "eventSchemaVersion"
      ],
      "additionalProperties": false
    },
    "objective": {
      "enum": [
        "own-request-points",
        "combined-team-request-points"
      ]
    },
    "actor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "stage": {
      "enum": [
        "declaration",
        "opening",
        "middle",
        "late"
      ]
    },
    "primaryCategory": {
      "enum": [
        "DIA",
        "HK",
        "Q",
        "LUT",
        "VOID",
        "COMB",
        "DBL",
        "INFER",
        "END",
        "TEAM"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DIA",
          "HK",
          "Q",
          "LUT",
          "VOID",
          "COMB",
          "DBL",
          "INFER",
          "END",
          "TEAM"
        ]
      }
    },
    "actorPacket": {
      "$ref": "packet.schema.json"
    },
    "originalChoice": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "originalRationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "selfReportedConfidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "rationaleAssessment": {
      "enum": [
        "adequate",
        "incomplete-explanation",
        "unsupported-claim",
        "incorrect-fact",
        "uncertain",
        "forced"
      ]
    },
    "actionAssessment": {
      "enum": [
        "supported-for-testing",
        "ambiguous",
        "counterexample",
        "proved-correction"
      ]
    },
    "missedOpportunity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "alternativeCandidateId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "objective": {
              "enum": [
                "own-request-points",
                "combined-team-request-points"
              ]
            },
            "advantage": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "proofKind": {
              "enum": [
                "native-objective-dominance",
                "information-set-exhaustive"
              ]
            },
            "proofRef": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^blobs/[a-f0-9]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "actorEvidenceRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^actor:/"
              }
            },
            "correction": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "alternativeCandidateId",
            "objective",
            "advantage",
            "proofKind",
            "proofRef",
            "actorEvidenceRefs",
            "correction"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "actor-review",
              "original-response",
              "reviewer-receipt"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^blobs/[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    },
    "retrospectiveRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^blobs/[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "eligibilityReceipt": {
      "type": "object",
      "properties": {
        "nativeLegal": {
          "const": true
        },
        "nonForced": {
          "const": true
        },
        "episodeComplete": {
          "const": true
        },
        "replayVerified": {
          "const": true
        },
        "actorReviewFrozen": {
          "const": true
        },
        "gameReviewFrozen": {
          "const": true
        },
        "materialChecksSupported": {
          "type": "boolean"
        },
        "correctionVerified": {
          "type": "boolean"
        }
      },
      "required": [
        "nativeLegal",
        "nonForced",
        "episodeComplete",
        "replayVerified",
        "actorReviewFrozen",
        "gameReviewFrozen",
        "materialChecksSupported",
        "correctionVerified"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "provenance": {
      "const": "offline-llm-player"
    },
    "promotionEligible": {
      "const": false
    },
    "runtimeActivated": {
      "const": false
    },
    "exactDecisionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptedProofReceiptRef": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^blobs/[a-f0-9]{64}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "corpusId",
    "caseId",
    "runId",
    "decisionId",
    "episodeId",
    "revision",
    "familyId",
    "variant",
    "request",
    "pin",
    "objective",
    "actor",
    "stage",
    "primaryCategory",
    "tags",
    "actorPacket",
    "originalChoice",
    "originalRationale",
    "selfReportedConfidence",
    "rationaleAssessment",
    "actionAssessment",
    "missedOpportunity",
    "evidenceRefs",
    "retrospectiveRef",
    "eligibilityReceipt",
    "limitations",
    "provenance",
    "promotionEligible",
    "runtimeActivated",
    "exactDecisionFingerprint",
    "acceptedProofReceiptRef"
  ],
  "additionalProperties": false,
  "title": "TrixCoachingCase"
}
