{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardford.local/schemas/trix-scenario-collection/declaration-response.schema.json",
  "title": "TrixScenarioDeclarationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cards",
    "reasoning",
    "confidence"
  ],
  "properties": {
    "cards": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\|[♠♥♦♣]\\|(A|K|Q|J|10|[2-9])\\|$"
      }
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
