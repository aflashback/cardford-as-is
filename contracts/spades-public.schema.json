{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spades-public.schema.json",
  "type": "object",
  "properties": {
    "handNumber": {
      "type": "integer",
      "minimum": 1
    },
    "dealer": {
      "type": "string",
      "enum": [
        "N",
        "E",
        "S",
        "W"
      ]
    },
    "currentSeat": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "N",
            "E",
            "S",
            "W"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "spadesBroken": {
      "type": "boolean"
    },
    "bids": {
      "type": "object",
      "properties": {
        "N": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 13
            },
            {
              "type": "null"
            }
          ]
        },
        "E": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 13
            },
            {
              "type": "null"
            }
          ]
        },
        "S": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 13
            },
            {
              "type": "null"
            }
          ]
        },
        "W": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 13
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "N",
        "E",
        "S",
        "W"
      ],
      "additionalProperties": false
    },
    "tricksWon": {
      "type": "object",
      "properties": {
        "N": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "E": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "S": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "W": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        }
      },
      "required": [
        "N",
        "E",
        "S",
        "W"
      ],
      "additionalProperties": false
    },
    "remainingCardCounts": {
      "type": "object",
      "properties": {
        "N": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "E": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "S": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "W": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        }
      },
      "required": [
        "N",
        "E",
        "S",
        "W"
      ],
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "properties": {
        "NS": {
          "type": "integer"
        },
        "EW": {
          "type": "integer"
        }
      },
      "required": [
        "NS",
        "EW"
      ],
      "additionalProperties": false
    },
    "bags": {
      "type": "object",
      "properties": {
        "NS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "EW": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": [
        "NS",
        "EW"
      ],
      "additionalProperties": false
    },
    "currentTrick": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "leader": {
              "type": "string",
              "enum": [
                "N",
                "E",
                "S",
                "W"
              ]
            },
            "plays": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "seat": {
                    "type": "string",
                    "enum": [
                      "N",
                      "E",
                      "S",
                      "W"
                    ]
                  },
                  "cardId": {
                    "type": "string",
                    "pattern": "^[CDHS](?:[2-9]|10|J|Q|K|A)$"
                  }
                },
                "required": [
                  "seat",
                  "cardId"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 3
            }
          },
          "required": [
            "leader",
            "plays"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "completedTricks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "leader": {
            "type": "string",
            "enum": [
              "N",
              "E",
              "S",
              "W"
            ]
          },
          "plays": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seat": {
                  "type": "string",
                  "enum": [
                    "N",
                    "E",
                    "S",
                    "W"
                  ]
                },
                "cardId": {
                  "type": "string",
                  "pattern": "^[CDHS](?:[2-9]|10|J|Q|K|A)$"
                }
              },
              "required": [
                "seat",
                "cardId"
              ],
              "additionalProperties": false
            },
            "minItems": 4,
            "maxItems": 4
          },
          "winner": {
            "type": "string",
            "enum": [
              "N",
              "E",
              "S",
              "W"
            ]
          }
        },
        "required": [
          "leader",
          "plays",
          "winner"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 13
    }
  },
  "required": [
    "handNumber",
    "dealer",
    "currentSeat",
    "spadesBroken",
    "bids",
    "tricksWon",
    "remainingCardCounts",
    "scores",
    "bags",
    "currentTrick",
    "completedTricks"
  ],
  "additionalProperties": false
}
