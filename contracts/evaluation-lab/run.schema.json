    "lab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "binaryDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "sourceDigest",
            "binaryDigest"
          ]
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gameId": {
              "enum": [
                "hearts",
                "spades",
                "trix"
              ]
            },
            "variantId": {
              "enum": [
                "solo",
                "partners",
                "basic-solo",
                "basic-partners",
                "complex-solo",
                "complex-partners"
              ]
            },
            "moduleVersion": {
              "type": "string",
              "minLength": 1
            },
            "ruleProfileId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "gameId",
            "variantId",
            "moduleVersion",
            "ruleProfileId"
          ]
        },
        "config": {
          "type": "object"
        },
        "seatPolicies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seat": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "seat",
              "id",
              "version"
            ]
          },
          "minItems": 4
        },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRounds": {
              "type": "integer",
              "minimum": 1
            },
            "maxActions": {
              "type": "integer",
              "minimum": 1
            },
            "maxTransitions": {
              "type": "integer",
              "minimum": 1
            },
            "maxWallMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1200000
            }
          },
          "required": [
            "maxRounds",
            "maxActions",
            "maxTransitions",
            "maxWallMs"
          ]
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
