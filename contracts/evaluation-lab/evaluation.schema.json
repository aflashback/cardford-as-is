{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardford.local/evaluation-lab/evaluation.json",
  "title": "evaluation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "coach-lab-evaluation-1.0.0"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "uncertain",
        "unsupported",
        "failed"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "horizon": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "testedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "untestedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionId": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "lower": {
            "type": "number"
          },
          "upper": {
            "type": "number"
          },
          "worlds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "actionId",
          "value",
          "lower",
          "upper",
          "worlds"
        ]
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "decisionId",
    "status",
    "objective",
    "horizon",
    "assumptions",
    "testedActions",
    "untestedActions",
    "evidenceRefs",
    "values",
    "limitations"
  ]
}
