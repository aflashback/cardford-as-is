{
  "name": "tricks-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:go": "node scripts/windows-env.mjs node scripts/dev-go.mjs",
    "dev:auth:setup": "node scripts/dev-auth.mjs setup",
    "dev:auth": "node scripts/dev-auth.mjs start",
    "dev:auth:status": "node scripts/dev-auth.mjs status",
    "dev:auth:stop": "node scripts/dev-auth.mjs stop",
    "dev:auth:reset": "node scripts/dev-auth.mjs reset",
    "dev:auth:regional": "node scripts/dev-auth.mjs regional",
    "start:scenarios": "node scripts/dev-scenarios.mjs",
    "start": "node web/server/index.ts",
    "start:go": "node scripts/windows-env.mjs node scripts/start-go.mjs",
    "pg:start": "node scripts/windows-env.mjs pg:start",
    "pg:stop": "node scripts/windows-env.mjs pg:stop",
    "start:reference": "node web/server/index.ts",
    "db:up": "node scripts/database.mjs up",
    "db:migrate": "node web/server/records/migrate.ts",
    "contracts:generate": "node web/scripts/generate-contracts.mjs",
    "contracts:check": "node web/scripts/generate-contracts.mjs --check",
    "contracts:auth:generate": "node web/scripts/generate-auth-contracts.mjs",
    "contracts:auth:check": "node web/scripts/generate-auth-contracts.mjs --check",
    "test:auth": "node web/scripts/check-auth.mjs",
    "test:auth:browser": "playwright test -c web/playwright.keycloak-auth.config.ts",
    "test:auth:live": "playwright test -c web/playwright.keycloak-live.config.ts",
    "test:auth:otp-policy": "node scripts/auth-build-otp.mjs --test",
    "typecheck": "npm run typecheck --workspace web",
    "build": "npm run build --workspace web",
    "test:legacy": "node --test --test-isolation=none web/tests/*.test.ts",
    "test:all": "node --env-file=.env.local --test --test-isolation=none web/tests/*.test.ts web/server/tests/*.test.ts",
    "test:integration": "node --env-file=.env.local --test --test-isolation=none web/server/tests/integration.test.ts web/server/tests/access-review.test.ts web/server/tests/billing.test.ts web/server/tests/family.test.ts web/server/tests/account-data.test.ts web/server/tests/provider-ledger.test.ts",
    "test:ui": "playwright test -c web/playwright.config.ts",
    "test:trix": "node scripts/trix-checks.mjs core",
    "test:stripe": "node --env-file=.env.local --test --test-isolation=none web/server/tests/billing.test.ts web/server/tests/billing-stripe-management.test.ts",
    "evaluate:local": "node web/server/evaluation/local-policy.ts",
    "evaluate:jev": "node web/server/evaluation/jev-smoke.ts",
    "db:backup:verify": "node scripts/verify-backup.mjs",
    "lint:boundaries": "node web/scripts/check-artifacts.mjs --source",
    "check:artifacts": "node web/scripts/check-artifacts.mjs",
    "lab:init": "node scripts/coach-lab.mjs init",
    "lab:run": "node scripts/coach-lab.mjs run",
    "lab:check": "node scripts/coach-lab.mjs check",
    "lab:report": "node scripts/coach-lab.mjs report",
    "lab:review": "node scripts/coach-lab.mjs review",
    "lab:export-human": "node scripts/coach-lab.mjs export-human",
    "lab:import-human": "node scripts/coach-lab.mjs import-human",
    "lab:evaluate": "node scripts/coach-lab.mjs evaluate",
    "lab:study": "node scripts/coach-lab-study.mjs",
    "lab:collect": "node scripts/trix-scenario-collection.mjs",
    "lab:collect:check": "node scripts/trix-scenario-collection/check.mjs"
  }
}
